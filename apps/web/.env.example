# Skitza — web app environment variables
#
# Copy to .env.local (git-ignored) and fill in real values. Never
# commit .env.local. `NEXT_PUBLIC_*` vars ship to the browser.

# ─── Database (Neon Postgres) ──────────────────────────────────────
# Primary connection string. Used by packages/db and every server
# runtime (RSC, route handlers, server actions, tRPC, migrations).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Test database (used by packages/db integration tests). Typically a
# throwaway Neon branch or a local docker-postgres.
DATABASE_URL_TEST=postgresql://user:password@host/db_test?sslmode=require

# ─── Clerk (auth) ──────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com — Configure → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Webhook signing secret — Configure → Webhooks → endpoint's "Signing Secret"
CLERK_WEBHOOK_SECRET=whsec_xxx

# ─── Public song links ─────────────────────────────────────────────
# Dedicated signing secret. Use at least 32 random characters and keep it
# stable: rotating it immediately invalidates every live public song URL.
# Do not reuse the Clerk secret or another application credential.
SONG_PUBLIC_LINK_SECRET=change-me-to-at-least-32-random-characters

# ─── Resend (transactional email) ──────────────────────────────────
RESEND_API_KEY=re_xxx
# Verified sender address.
RESEND_FROM_EMAIL=Skitza <notifications@skitza.app>

# ─── R2 (audio + file storage) ─────────────────────────────────────
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET=skitza-audio
R2_PUBLIC_HOST=https://pub-xxx.r2.dev

# ─── Magic links (artist view tokens) ──────────────────────────────
MAGIC_LINK_SECRET=change-me-to-32-bytes-of-random-hex

# ─── Cron auth ─────────────────────────────────────────────────────
# Bearer token Vercel's scheduled crons present to our /api/cron/* routes.
CRON_SECRET=change-me-to-random

# ─── Sentry (error tracking + perf) ────────────────────────────────
# Added 2026-04-22 — audit Task 14 observability.
#
# Get the DSN from https://sentry.io → Project → Settings → Client Keys.
# If unset, the SDK no-ops cleanly (no build failure, no runtime errors).
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Build-time source-map upload. Create an Internal Integration in
# Sentry's org settings with "Releases: Admin" scope, then paste here.
# Required only for production builds where you want symbolicated
# stack traces — optional in dev.
SENTRY_ORG=skitza
SENTRY_PROJECT=web
SENTRY_AUTH_TOKEN=sntrys_xxx

# ─── PostHog (product analytics) ───────────────────────────────────
# Added 2026-04-22 — audit Task 14 observability.
#
# Get the project API key from https://app.posthog.com → Project
# Settings → API Keys. The host depends on your region — US projects
# use https://us.i.posthog.com; EU projects use https://eu.i.posthog.com.
# If unset, PostHog no-ops (no events captured, no errors thrown).
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── SK-102 isolated browser runtime (opt-in; keep commented) ─────
# Use only with docs/runbooks/sk102-isolated-browser-environment.md.
# Every value is required together. The guard rejects partial setup,
# production deployment, telemetry, Resend, payment-provider variables,
# protected target fingerprints, and non-isolated database/bucket names.
# Never commit actual credentials or observed fingerprints.
#
# SK102_E2E_MODE=isolated_nonproduction
# SK102_DISPOSABLE_CONFIRMATION=isolated-disposable
# SK102_SLOT=sk102-browser
# SK102_PAYMENT_MODE=off_app_test
# NEXT_TELEMETRY_DISABLED=1
# SK102_BROWSER_ORIGIN=http://127.0.0.1:3102
# SITE_URL=http://127.0.0.1:3102
# DATABASE_URL=postgresql://user:password@isolated-host/skitza_sk102_browser?sslmode=require
# SK102_DATABASE_OBSERVED_TARGET_FINGERPRINT=sha256:<64-hex>
# SK102_DATABASE_APPROVED_TARGET_FINGERPRINT=sha256:<64-hex>
# SK102_DATABASE_FORBIDDEN_TARGET_FINGERPRINTS=sha256:<64-hex>,sha256:<64-hex>
# SK102_DATABASE_APPROVED_ENDPOINT_FINGERPRINT=sha256:<64-hex>
# SK102_DATABASE_FORBIDDEN_ENDPOINT_FINGERPRINTS=sha256:<64-hex>,sha256:<64-hex>
# SK102_DATABASE_APPROVED_CREDENTIAL_FINGERPRINT=sha256:<64-hex>
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<isolated-development-instance>
# Optional @clerk/testing alias; when set it must be byte-for-byte identical:
# CLERK_PUBLISHABLE_KEY=pk_test_<same-isolated-development-instance>
# CLERK_SECRET_KEY=sk_test_<isolated-development-instance>
# CLERK_WEBHOOK_SECRET=whsec_<isolated-development-endpoint>
# SK102_CLERK_APPROVED_TARGET_FINGERPRINT=sha256:<64-hex>
# SK102_CLERK_APPROVED_CREDENTIAL_FINGERPRINT=sha256:<64-hex>
# SK102_CLERK_FORBIDDEN_TARGET_FINGERPRINTS=sha256:<64-hex>
# R2_ACCOUNT_ID=<32-hex>
# R2_ACCESS_KEY_ID=<isolated-key-id>
# R2_SECRET_ACCESS_KEY=<isolated-secret>
# R2_BUCKET_AUDIO=skitza-sk102-browser-audio
# R2_BUCKET_DOCS=skitza-sk102-browser-docs
# SK102_R2_ALLOWED_ORIGIN=http://127.0.0.1:3102
# SK102_R2_APPROVED_TARGET_FINGERPRINT=sha256:<64-hex>
# SK102_R2_APPROVED_CREDENTIAL_FINGERPRINT=sha256:<64-hex>
# SK102_R2_FORBIDDEN_TARGET_FINGERPRINTS=sha256:<64-hex>
# SK102_PROTECTED_R2_BUCKETS=skitza-audio,skitza-docs,<other-protected-bucket>
# SK102_EMAIL_MODE=r2_capture
# SK102_EMAIL_ALLOWED_RECIPIENT_DOMAIN=example.com
# SK102_EMAIL_FROM=Skitza SK-102 <no-reply@sk102.invalid>
# SKITZA_E2E_PRODUCER_CLERK_USER_ID=<fixture-user-id>
# SKITZA_E2E_ARTIST_CLERK_USER_ID=<different-fixture-user-id>
# SKITZA_E2E_PRODUCER_EMAIL=producer+clerk_test@example.com
# SKITZA_E2E_ARTIST_EMAIL=artist+clerk_test@example.com
# Process environment only; never store this one-shot approval in the private file:
# SK102_R2_CORS_MUTATION_CONFIRMATION=approved-exact-sk102-r2-cors-targets
