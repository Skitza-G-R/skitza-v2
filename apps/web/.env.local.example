DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Stable Web Push VAPID identity. Never expose the private key through a
# NEXT_PUBLIC_* variable.
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@skitza.app
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Dedicated public-song signing secret (32+ random characters). Rotating it
# invalidates all live /listen links; do not reuse CLERK_SECRET_KEY.
SONG_PUBLIC_LINK_SECRET=
MAGIC_LINK_SECRET=
SITE_URL=
# Phase H.4c — transactional email via Resend.
# RESEND_API_KEY: get from https://resend.com/api-keys
# RESEND_FROM:    e.g. "Skitza <hello@skitza.app>" — must be a verified
#                 domain or the resend.dev sandbox sender.
# CRON_SECRET:    random string. Used by Vercel Cron + checked by
#                 /api/cron/session-reminders to authorize invocations.
RESEND_API_KEY=
RESEND_FROM=
CRON_SECRET=
