# Reuse the existing Skitza Clerk application so Gili signs in with her
# normal account. The account must have private metadata:
# { "skitzaAdminRole": "founder" }
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudflare Access protects only the separate admin hostname. These
# server-only values are not credentials, but all four are required and must
# match the exact founder-only Access application and proxied hostname.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_FOUNDER_SUB=
ADMIN_CANONICAL_HOST=

# A random server-only value with at least 32 characters. It signs the
# inactivity and reauthentication tokens and must differ between deployments.
ADMIN_SESSION_SECRET=

# The one server-only database binding. Admin reads the live database and
# nothing else; SK-288 removed the Live/Test split and its ADMIN_TEST_* twins.
ADMIN_LIVE_DATABASE_URL=

# Clerk lifecycle reconciliation and founder-only Producer invitations.
# Reconciliation is read-only. The Producer invitation action sends a marked
# Clerk application invitation to an eligible Artist's verified primary email.
ADMIN_LIVE_CLERK_SECRET_KEY=
ADMIN_LIVE_CLERK_INSTANCE_ID=
ADMIN_LIVE_CLERK_DASHBOARD_URL=
ADMIN_LIVE_WEB_APP_URL=https://skitza.app

# Beta invitations are sent by us, not by Clerk (`notify: false`), because
# Clerk's own mail goes out over its shared SendGrid pool and Gmail files it
# under Promotions where invitees never see it.
#
# ADMIN_LIVE_INVITE_FROM must carry a display name and a mailbox that actually
# accepts mail — the reply path is what keeps the message in the Primary tab.
# The sign-off uses the first word of the display name.
ADMIN_LIVE_RESEND_API_KEY=
# Must be an address on a domain verified in Resend — today that is
# send.skitza.app, not the skitza.app root. Reply-To needs no verification.
ADMIN_LIVE_INVITE_FROM=Gili from Skitza <gili@send.skitza.app>
ADMIN_LIVE_INVITE_REPLY_TO=
